// Windows resources: application icon and version information.
#include <winver.h>

IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,1,0,0
 PRODUCTVERSION 2,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "Cosmic Studio"
            VALUE "FileDescription", "Cosmic Platformer"
            VALUE "FileVersion", "2.1.0"
            VALUE "InternalName", "CosmicPlatformer"
            VALUE "OriginalFilename", "CosmicPlatformer.exe"
            VALUE "ProductName", "Cosmic Platformer"
            VALUE "ProductVersion", "2.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40C, 1200
    END
END
