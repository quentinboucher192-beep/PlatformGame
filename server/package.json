{
  "name": "cosmic-online-server",
  "version": "1.0.0",
  "private": true,
  "description": "Cosmic Online Ranking - Cloudflare Workers REST API (D1 + R2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "db:migrate:local": "wrangler d1 migrations apply cosmic-online-dev --local --env dev",
    "db:seed:local": "wrangler d1 execute cosmic-online-dev --local --env dev --file=seed/levels.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.161.0"
  }
}
