{
  "name": "cosmic-online-server",
  "version": "1.0.0",
  "private": true,
  "description": "Cosmic Online Ranking - Cloudflare Workers REST API (D1 + R2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "db:migrate:local": "wrangler d1 migrations apply cosmic-online-dev --local --env dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "dev:setup": "bash scripts/dev-setup.sh",
    "levels:register": "node scripts/register-levels.mjs",
    "countries:generate": "node scripts/generate-countries.mjs",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy",
    "db:migrate:staging": "wrangler d1 migrations apply cosmic-online-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply cosmic-online-prod --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.161.0"
  }
}
